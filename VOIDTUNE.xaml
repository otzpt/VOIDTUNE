                                                    <TextBlock Text="{Binding Detail}"
                                                               FontFamily="{StaticResource FontMono}"
                                                               FontSize="{StaticResource FontSizeXS}"
                                                               Foreground="{StaticResource TextDim}"
                                                               Margin="0,3,0,0"
