                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Date}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
