<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="VOIDTUNE SUITE v0.8" Height="740" Width="1140"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ══════════════════════════════════════════════════════════════
             COLOR PALETTE
        ══════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BgBase"         Color="#09070F"/>
        <SolidColorBrush x:Key="BgSidebar"      Color="#07060D"/>
        <SolidColorBrush x:Key="BgCard"         Color="#100E1C"/>
        <SolidColorBrush x:Key="BgCardHover"    Color="#16122A"/>
        <SolidColorBrush x:Key="BgTopbar"       Color="#08070E"/>
        <SolidColorBrush x:Key="BgLogBar"       Color="#06050B"/>
        <SolidColorBrush x:Key="BgInput"        Color="#0C0A18"/>

        <SolidColorBrush x:Key="AccentViolet"      Color="#9333EA"/>
        <SolidColorBrush x:Key="AccentVioletLight" Color="#C084FC"/>
        <SolidColorBrush x:Key="AccentVioletDark"  Color="#4C1D95"/>
        <SolidColorBrush x:Key="AccentPink"        Color="#F472B6"/>
        <SolidColorBrush x:Key="AccentGreen"       Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentBlue"        Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentAmber"       Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed"         Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentCyan"        Color="#22D3EE"/>

        <SolidColorBrush x:Key="BorderSubtle"   Color="#1A1530"/>
        <SolidColorBrush x:Key="BorderMid"      Color="#261E42"/>
        <SolidColorBrush x:Key="BorderAccent"   Color="#4C1D95"/>

        <SolidColorBrush x:Key="TextPrimary"    Color="#F5F0FF"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#D8D0F0"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#7C6FA0"/>
        <SolidColorBrush x:Key="TextDim"        Color="#3D3560"/>
        <SolidColorBrush x:Key="TextDark"       Color="#5A4E80"/>

        <!-- ══════════════════════════════════════════════════════════════
             GALAXY GRADIENT BRUSHES
        ══════════════════════════════════════════════════════════════ -->
        <RadialGradientBrush x:Key="GradVoidBg" GradientOrigin="0.5,0.3" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#130F22" Offset="0"/>
            <GradientStop Color="#09070F" Offset="0.55"/>
            <GradientStop Color="#06050C" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="GradTopbar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0C0916" Offset="0"/>
            <GradientStop Color="#160B2C" Offset="0.5"/>
            <GradientStop Color="#0C0916" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradSidebar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#07060D" Offset="0"/>
            <GradientStop Color="#0B0918" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradWindowBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4C1D95" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="0.35"/>
            <GradientStop Color="#F472B6" Offset="0.65"/>
            <GradientStop Color="#4C1D95" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradHorizLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A1530" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="0.3"/>
            <GradientStop Color="#EC4899" Offset="0.5"/>
            <GradientStop Color="#7C3AED" Offset="0.7"/>
            <GradientStop Color="#1A1530" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradActiveBtn" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C0E38" Offset="0"/>
            <GradientStop Color="#240E3E" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GradHealthCard" GradientOrigin="0.5,0.3" Center="0.5,0.5">
            <GradientStop Color="#1E0E38" Offset="0"/>
            <GradientStop Color="#14102A" Offset="0.6"/>
            <GradientStop Color="#100E20" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="GradCardBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9333EA" Offset="0"/>
            <GradientStop Color="#F472B6" Offset="1"/>
        </LinearGradientBrush>

        <!-- ══════════════════════════════════════════════════════════════
             TYPOGRAPHY CONSTANTS
        ══════════════════════════════════════════════════════════════ -->
        <FontFamily x:Key="FontMono">Consolas</FontFamily>
        <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
        <FontFamily x:Key="FontSymbol">Segoe UI Symbol</FontFamily>

        <sys:Double x:Key="FontSizeXS">8</sys:Double>
        <sys:Double x:Key="FontSizeSM">9</sys:Double>
        <sys:Double x:Key="FontSizeMD">10</sys:Double>
        <sys:Double x:Key="FontSizeLG">12</sys:Double>
        <sys:Double x:Key="FontSizeXL">14</sys:Double>
        <sys:Double x:Key="FontSizeTitle">18</sys:Double>
        <sys:Double x:Key="FontSizeHero">56</sys:Double>

        <!-- ══════════════════════════════════════════════════════════════
             BASE STYLES (MergedDictionaries alternative)
        ══════════════════════════════════════════════════════════════ -->

        <!-- ── SIDEBAR NAVIGATION BUTTON ── -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- animated hover layer -->
                            <Border x:Name="hoverBg"
                                    Background="{StaticResource BgCardHover}"
                                    CornerRadius="0,4,4,0"
                                    Margin="4,1,8,1"
                                    Opacity="0"/>
                            <Border BorderThickness="2,0,0,0"
                                    BorderBrush="Transparent"
                                    CornerRadius="0,4,4,0"
                                    Margin="4,1,8,1">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="#D4C8F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ACTIVE SIDEBAR BUTTON ── -->
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentVioletLight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradActiveBtn}"
                                BorderThickness="2,0,0,0"
                                BorderBrush="{StaticResource AccentViolet}"
                                CornerRadius="0,4,4,0"
                                Margin="4,1,8,1">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PRIMARY ACTION BUTTON ── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentVioletDark}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentViolet}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#220E3E"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentViolet}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SUCCESS/GREEN BUTTON ── -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#16532C"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A2016"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── WARNING/AMBER BUTTON ── -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4A3010"/>
            <Setter Property="Foreground" Value="{StaticResource AccentAmber}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1000"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentAmber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ICON BUTTON (TOPBAR) ── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSymbol}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter Property="Foreground" Value="#C0C0D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CLOSE BUTTON ── -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A0E0E"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── COLOR SWATCH ── -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TAB ITEM ── -->
        <Style x:Key="ModernTab" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                BorderThickness="0,0,0,2" 
                                BorderBrush="Transparent"
                                Background="Transparent" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentViolet}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentVioletLight}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C0C0D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SCROLLBAR ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource BorderMid}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TEXT STYLES ── -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8B5CF6"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- ── CARD STYLES ── -->
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="AccentCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="2,1,1,1"/>
        </Style>

        <!-- ── INPUT STYLE ── -->
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C0C0D8"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentViolet}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- ── TWEAK CARD ── -->
        <Style x:Key="TweakCard" TargetType="Border">
            <Setter Property="Width" Value="308"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ── LIST ITEM STYLE ── -->
        <Style x:Key="ListItem" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             DATA TEMPLATES
        ══════════════════════════════════════════════════════════════ -->

        <!-- Tweak Card Template -->
        <DataTemplate x:Key="TweakCardTemplate">
            <Border Style="{StaticResource TweakCard}"
                    BorderBrush="{Binding AppliedBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" 
                                  IsChecked="{Binding Sel}" 
                                  Tag="{Binding Id}"
                                  VerticalAlignment="Top" 
                                  Margin="0,2,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" 
                                       FontFamily="{StaticResource FontUI}" 
                                       FontSize="{StaticResource FontSizeLG}"
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding Desc}" 
                                       FontFamily="{StaticResource FontMono}" 
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{StaticResource TextDark}" 
                                       Margin="0,3,0,0" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" 
                                BorderBrush="{Binding BC}" 
                                BorderThickness="1"
                                Padding="5,2" 
                                VerticalAlignment="Top" 
                                Margin="8,0,0,0"
                                CornerRadius="3">
                            <TextBlock Text="{Binding Badge}" 
                                       FontFamily="{StaticResource FontMono}" 
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{Binding BC}" 
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <!-- Applied footer -->
                    <Grid Margin="0,8,0,0" 
                          Visibility="{Binding Applied, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" 
                                     Fill="{StaticResource AccentGreen}"
                                     VerticalAlignment="Center" 
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="APPLIED" 
                                       FontFamily="{StaticResource FontMono}" 
                                       FontSize="{StaticResource FontSizeXS}"
                                       Foreground="{StaticResource AccentGreen}" 
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Name="BtnDisableTweak"
                                Content="DISABLE"
                                Tag="{Binding Id}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeXS}"
                                FontWeight="Bold"
                                Padding="8,3"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderMid}"
                                Foreground="{StaticResource TextDark}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- App Card Template -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border x:Name="AppCard" 
                    Style="{StaticResource DarkCard}"
                    Width="150"
                    Margin="0,0,6,6" 
                    Padding="10,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="{Binding Name}"
                               FontFamily="{StaticResource FontUI}" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#C0C0D8" 
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" 
                              IsChecked="{Binding Sel}"
                              VerticalAlignment="Center" 
                              Margin="6,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Cat}" 
                               FontFamily="{StaticResource FontMono}" 
                               FontSize="{StaticResource FontSizeXS}"
                               Foreground="{StaticResource BorderMid}" 
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Service Item Template -->
        <DataTemplate x:Key="ServiceItemTemplate">
            <Border Style="{StaticResource ListItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Name}" 
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeLG}" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Desc}" 
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeSM}" 
                               Foreground="{StaticResource TextDark}" 
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2" 
                            BorderBrush="{Binding SC}" 
                            BorderThickness="1"
                            CornerRadius="3" 
                            Padding="6,2" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" 
                                   FontFamily="{StaticResource FontMono}" 
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{Binding SC}" 
                                   FontWeight="Bold"/>
                    </Border>
                    <Button Grid.Column="3" 
                            Content="STOP"  
                            Tag="{Binding Name}"
                            Style="{StaticResource ActionButton}" 
                            Margin="6,0,4,0" 
                            Padding="10,4"/>
                    <Button Grid.Column="4" 
                            Content="START" 
                            Tag="{Binding Name}"
                            Style="{StaticResource SuccessButton}" 
                            Padding="10,4"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Privacy Item Template -->
        <DataTemplate x:Key="PrivacyItemTemplate">
            <Border Style="{StaticResource ListItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" 
                              IsChecked="{Binding Sel}" 
                              Tag="{Binding Id}"
                              VerticalAlignment="Center" 
                              Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" 
                                   FontFamily="{StaticResource FontUI}" 
                                   FontSize="{StaticResource FontSizeLG}"
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding Desc}" 
                                   FontFamily="{StaticResource FontMono}" 
                                   FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource TextDark}" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" 
                            BorderBrush="{Binding BC}" 
                            BorderThickness="1"
                            CornerRadius="3" 
                            Padding="5,2" 
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Badge}" 
                                   FontFamily="{StaticResource FontMono}" 
                                   FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{Binding BC}" 
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         ROOT LAYOUT
    ══════════════════════════════════════════════════════════════════ -->
    <Border Background="{StaticResource GradVoidBg}"
            CornerRadius="8"
            BorderBrush="{StaticResource GradWindowBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- Topbar -->
                <RowDefinition Height="*"/>    <!-- Body   -->
                <RowDefinition Height="46"/>   <!-- Log    -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════
                 TOPBAR
            ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource GradTopbar}"
                    BorderBrush="{StaticResource GradHorizLine}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Logo area -->
                        <ColumnDefinition Width="*"/>     <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/>  <!-- CPU/RAM -->
                        <ColumnDefinition Width="Auto"/>  <!-- Admin badge -->
                        <ColumnDefinition Width="Auto"/>  <!-- Window controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource AccentViolet}" Opacity="0.15"
                                      Data="M12,2 L22,12 L12,22 L2,12 Z"/>
                                <Path Stroke="{StaticResource AccentViolet}" StrokeThickness="1.5" Fill="Transparent"
                                      Data="M12,2 L22,12 L12,22 L2,12 Z"/>
                                <Path Stroke="{StaticResource AccentVioletLight}" StrokeThickness="1" Fill="Transparent" Opacity="0.5"
                                      Data="M12,5 L19,12 L12,19 L5,12 Z"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VOID" 
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXL}" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="TUNE" 
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXL}" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentViolet}"/>
                            </StackPanel>
                            <TextBlock Text="SUITE · @OTZPT"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="7"
                                       Foreground="#7C4DB8"/>
                        </StackPanel>
                        <Border Background="#250F40"
                                BorderBrush="{StaticResource AccentViolet}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="v0.8"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{StaticResource AccentVioletLight}"/>
                        </Border>
                    </StackPanel>

                    <!-- Quick tiered apply actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,18,0">
                        <Button x:Name="BtnTopSafe" Content="⚡ SAFE"
                                Style="{StaticResource SuccessButton}"
                                Height="26" Padding="10,0" Margin="0,0,6,0"
                                FontSize="{StaticResource FontSizeSM}"
                                ToolTip="Apply ALL safe tweaks in one click"/>
                        <Button x:Name="BtnTopExtreme" Content="EXTREME"
                                Style="{StaticResource ActionButton}"
                                Height="26" Padding="10,0" Margin="0,0,6,0"
                                FontSize="{StaticResource FontSizeSM}"
                                ToolTip="Apply all SAFE + EXTREME tweaks"/>
                        <Button x:Name="BtnTopNuclear" Content="☢ NUCLEAR"
                                Style="{StaticResource ActionButton}"
                                BorderBrush="{StaticResource AccentRed}"
                                Foreground="{StaticResource AccentRed}"
                                Height="26" Padding="10,0" Margin="0,0,6,0"
                                FontSize="{StaticResource FontSizeSM}"
                                ToolTip="Apply EVERYTHING including security-disabling NUCLEAR tweaks"/>
                        <Button x:Name="BtnTopRevert" Content="↺ REVERT ALL"
                                Style="{StaticResource ActionButton}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                Foreground="{StaticResource TextMuted}"
                                Height="26" Padding="10,0"
                                FontSize="{StaticResource FontSizeSM}"
                                ToolTip="Revert every applied tweak to Windows defaults"/>
                    </StackPanel>

                    <!-- CPU/RAM Mini -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <StackPanel Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU" 
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXS}" 
                                           Foreground="{StaticResource TextDim}" 
                                           Margin="0,0,4,0"/>
                                <TextBlock x:Name="CpuLbl" 
                                           Text="--%"  
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXS}" 
                                           Foreground="{StaticResource AccentViolet}"/>
                            </StackPanel>
                            <ProgressBar x:Name="CpuBar" 
                                         Value="0" 
                                         Maximum="100" 
                                         Width="64" 
                                         Height="2"
                                         Background="{StaticResource BorderSubtle}" 
                                         Foreground="{StaticResource AccentViolet}" 
                                         BorderThickness="0"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM" 
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXS}" 
                                           Foreground="{StaticResource TextDim}" 
                                           Margin="0,0,4,0"/>
                                <TextBlock x:Name="RamLbl" 
                                           Text="--GB" 
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="{StaticResource FontSizeXS}" 
                                           Foreground="{StaticResource AccentViolet}"/>
                            </StackPanel>
                            <ProgressBar x:Name="RamBar" 
                                         Value="0" 
                                         Maximum="100" 
                                         Width="64" 
                                         Height="2"
                                         Background="{StaticResource BorderSubtle}" 
                                         Foreground="{StaticResource AccentViolet}" 
                                         BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Admin Badge -->
                    <Border Grid.Column="3"
                            Background="#180B32"
                            BorderBrush="{StaticResource AccentViolet}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7,3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5"
                                     Fill="{StaticResource AccentPink}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,5,0"/>
                            <TextBlock Text="ADMIN"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource FontSizeSM}"
                                       Foreground="{StaticResource AccentVioletLight}"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnWinMin"   Content="—"  Style="{StaticResource IconButton}"/>
                        <Button x:Name="BtnWinMax"   Content="⬜" Style="{StaticResource IconButton}" FontSize="10"/>
                        <Button x:Name="BtnWinClose" Content="✕" Style="{StaticResource CloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 BODY: SIDEBAR + PAGES
            ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── SIDEBAR ─────────────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="{StaticResource GradSidebar}"
                        BorderBrush="{StaticResource GradWindowBorder}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" 
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,10,0,0">

                                <!-- MAIN -->
                                <TextBlock Text="MAIN" Style="{StaticResource SectionLabel}" Margin="16,10,0,4"/>
                                <Button x:Name="BtnDash" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="6" Height="6" 
                                                           Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="9" Canvas.Top="1" Width="6" Height="6" 
                                                           Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" 
                                                           Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" 
                                                           Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- OPTIMIZE -->
                                <TextBlock Text="OPTIMIZE" Style="{StaticResource SectionLabel}" Margin="16,8,0,4"/>
                                <Button x:Name="BtnTweaks" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,1 L9.5,5.5 L14,5.5 L10.5,8.5 L12,13 L8,10 L4,13 L5.5,8.5 L2,5.5 L6.5,5.5 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnApps" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M2,4 L14,4 M2,8 L10,8 M2,12 L12,12"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M12,9 L12,15 M9,12 L15,12"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="App Installer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnServices" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,2 A6,6 0 1 1 7.9,2"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" Fill="Transparent"
                                                      Data="M8,5 L8,8 L10,10"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Services" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStartup" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,14 L8,4 M4,8 L8,4 L12,8"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Startup" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPrivacy" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,1 L14,4 L14,9 C14,12.5 11.5,14.8 8,15.5 C4.5,14.8 2,12.5 2,9 L2,4 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Privacy" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPersonalize" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M2,12 L5,5 L8,10 L11,7 L14,12 Z"/>
                                                <Ellipse Canvas.Left="10" Canvas.Top="1" Width="5" Height="5"
                                                         Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Personalize" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- DIAGNOSTICS -->
                                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionLabel}" Margin="16,8,0,4"/>
                                <Button x:Name="BtnDiag" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,1 A7,7 0 1 1 7.9,1"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                                                      Data="M8,5 L8,9 M8,11 L8,12"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="System Info" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnBench" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M2,14 L2,8 L5,8 L5,6 L8,6 L8,4 L11,4 L11,2 L14,2 L14,14 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Benchmarks" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnProc" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Processes" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDrivers" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M3,5 L8,2 L13,5 L13,11 L8,14 L3,11 Z"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1" Fill="Transparent"
                                                      Data="M8,2 L8,8 M3,5 L8,8 M13,5 L8,8"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Driver Info" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnGpuHealth" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Rectangle Canvas.Left="1" Canvas.Top="4" Width="14" Height="9" RadiusX="2" RadiusY="2"
                                                           Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                                                      Data="M4,8 L6,6 L8,9 L10,7 L12,8"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M13,4 L14.5,1.5 M15,4 L15.5,1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="GPU Health" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLatency" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M2,8 A6,6 0 1 1 14,8"/>
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                                      Data="M8,8 L10.5,5.5"/>
                                                <Ellipse Canvas.Left="6.5" Canvas.Top="6.5" Width="3" Height="3"
                                                         Fill="{StaticResource TextMuted}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Latency Check" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- TOOLS -->
                                <TextBlock Text="TOOLS" Style="{StaticResource SectionLabel}" Margin="16,8,0,4"/>
                                <Button x:Name="BtnSafety" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M8,1 L14,4 L14,9 C14,12.5 11.5,14.8 8,15.5 C4.5,14.8 2,12.5 2,9 L2,4 Z"/>
                                                <Path Stroke="{StaticResource AccentGreen}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M5,8 L7,10 L11,6" Opacity="0.6"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Backup / Restore" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnScript" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="{StaticResource TextMuted}" StrokeThickness="1.3" Fill="Transparent"
                                                      Data="M4,4 L1,8 L4,12 M12,4 L15,8 L12,12 M9,2 L7,14"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Script Runner" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Actions -->
                        <StackPanel Grid.Row="1" Margin="10,8,10,12">
                            <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,0,0,10"/>

                            <!-- One-click presets -->
                            <Button x:Name="BtnSelectAll"
                                    Content="SELECT ALL"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,0,5" Height="30" FontSize="{StaticResource FontSizeMD}"/>

                            <Button x:Name="BtnGamingMode"
                                    Height="34" Margin="0,0,0,8"
                                    FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                    Cursor="Hand" BorderThickness="1" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1A1000"/>
                                        <Setter Property="BorderBrush" Value="#4A3010"/>
                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#241800"/>
                                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F3AE;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="GAMING MODE" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Text="CPU + GPU + Game tweaks (SAFE)" FontSize="8" Foreground="#7A5A1A" FontFamily="Consolas"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,0,0,8"/>

                            <Button x:Name="BtnApplyAll" Content="▶  APPLY SELECTED"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,0,5" Height="32" FontSize="{StaticResource FontSizeMD}"/>
                            <Button x:Name="BtnSafeMode" Content="✓  SELECT SAFE"
                                    Style="{StaticResource SuccessButton}"
                                    Margin="0,0,0,5" Height="30" FontSize="{StaticResource FontSizeMD}"/>
                            <Button x:Name="BtnClearAll" Content="CLEAR ALL"
                                    Style="{StaticResource ActionButton}"
                                    BorderBrush="{StaticResource BorderSubtle}" Foreground="{StaticResource TextDark}"
                                    Height="28" FontSize="{StaticResource FontSizeMD}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── PAGE HOST ───────────────────────────────────── -->
                <Grid Grid.Column="1" Background="{StaticResource BgBase}">

                    <!-- ========== DASHBOARD ========== -->
                    <ScrollViewer x:Name="PgDash" 
                                  Visibility="Visible" 
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="SYSTEM HEALTH OVERVIEW" 
                                               Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRefreshDash" 
                                        Content="↻  REFRESH"
                                        Style="{StaticResource ActionButton}" 
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Health + Stats Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Health Score -->
                                <Border Grid.Column="0" Style="{StaticResource AccentCard}"
                                        Margin="0,0,10,0" Padding="20,18"
                                        Background="{StaticResource GradHealthCard}"
                                        BorderBrush="{StaticResource GradCardBorder}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="HEALTH" 
                                                   FontFamily="{StaticResource FontMono}" 
                                                   FontSize="{StaticResource FontSizeSM}"
                                                   Foreground="{StaticResource TextDark}" 
                                                   HorizontalAlignment="Center" 
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="HealthScore"
                                                   Text="--"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="{StaticResource FontSizeHero}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentVioletLight}"
                                                   HorizontalAlignment="Center"
                                                   LineHeight="56">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#9333EA" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock x:Name="HealthLabel" 
                                                   Text="LOADING..." 
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="{StaticResource FontSizeMD}" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" 
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stats Grid -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" 
                                            Style="{StaticResource AccentCard}"
                                            Margin="0,0,8,8"
                                            BorderBrush="{StaticResource AccentViolet}">
                                        <StackPanel>
                                            <TextBlock Text="CPU" FontFamily="{StaticResource FontMono}" 
                                                       FontSize="{StaticResource FontSizeSM}" 
                                                       Foreground="{StaticResource TextDark}"/>
                                            <TextBlock x:Name="DashCpu" Text="--%"  
                                                       FontFamily="{StaticResource FontMono}" 
                                                       FontSize="26"
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource AccentViolet}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" 
                                            Style="{StaticResource AccentCard}"
                                            Margin="0,0,8,8"
                                            BorderBrush="{StaticResource AccentBlue}">
                                        <StackPanel>
                                            <TextBlock Text="RAM" FontFamily="{StaticResource FontMono}" 
                                                       FontSize="{StaticResource FontSizeSM}" 
                                                       Foreground="{StaticResource TextDark}"/>
                                            <TextBlock x:Name="DashRam" Text="--GB" 
                                                       FontFamily="{StaticResource FontMono}" 
                                                       FontSize="26"
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource AccentBlue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" 
                                            Style="{StaticResource AccentCard}"
                                            Margin="0,0,0,8"
                                            BorderBrush="{StaticResource AccentAmber}">
                                        <StackPanel>
                                            <TextBlock Text="PROCESSES" FontFamily="{StaticResource FontMono}" 
                                                       FontSize="{StaticResource FontSizeSM}" 
                                                       Foreground="{StaticResource TextDark}"/>
                                            <TextBlock x:Name="DashProcs" Text="--" 
                                                       FontFamily="{StaticResource FontMono}" 
                                                       FontSize="26"
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource AccentAmber}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" 
                                            Style="{StaticResource AccentCard}"
                                            Margin="0,0,8,0"
                                            BorderBrush="{StaticResource AccentGreen}">
                                        <StackPanel>
                                            <TextBlock Text="APPLIED TWEAKS" FontFamily="{StaticResource FontMono}" 
                                                       FontSize="{StaticResource FontSizeSM}" 
                                                       Foreground="{StaticResource TextDark}"/>
                                            <TextBlock x:Name="DashApplied" Text="0" 
                                                       FontFamily="{StaticResource FontMono}" 
                                                       FontSize="26"
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource AccentGreen}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" 
                                            Style="{StaticResource AccentCard}"
                                            Margin="0,0,8,0"
                                            BorderBrush="{StaticResource AccentPink}">
                                        <StackPanel>
                                            <TextBlock Text="BACKUPS" FontFamily="{StaticResource FontMono}" 
                                                       FontSize="{StaticResource FontSizeSM}" 
                                                       Foreground="{StaticResource TextDark}"/>
                                            <TextBlock x:Name="DashBackups" Text="0" 
                                                       FontFamily="{StaticResource FontMono}" 
                                                       FontSize="26"
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource AccentPink}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Bottleneck Analysis -->
                            <TextBlock Text="BOTTLENECK ANALYSIS" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource DarkCard}" 
                                    Padding="14,12" Margin="0,0,0,6">
                                <TextBlock x:Name="BnText" 
                                           Text="Click REFRESH to analyse..."
                                           FontFamily="{StaticResource FontMono}" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextDark}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Quick Actions -->
                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel>
                                <Button x:Name="BtnQFlushDns"   Content="FLUSH DNS"         Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="BtnQClearTemp"  Content="CLEAR TEMP"        Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="BtnQRestartExp" Content="RESTART EXPLORER"  Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="BtnQRecycleBin" Content="EMPTY RECYCLE BIN" Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="BtnQDefrag"     Content="DEFRAG C:"         Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock x:Name="QuickActLog" 
                                       Text="" 
                                       FontFamily="{StaticResource FontMono}" 
                                       FontSize="{StaticResource FontSizeMD}"
                                       Foreground="{StaticResource AccentGreen}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== TWEAKS ========== -->
                    <Grid x:Name="PgTweaks" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Tweaks" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="SELECT TWEAKS · THEN APPLY SELECTED" 
                                       Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>

                        <TabControl Grid.Row="1" x:Name="TweakTabs" 
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderSubtle}" 
                                    BorderThickness="0,0,0,1" 
                                    Margin="24,0,24,0">
                            <TabControl.Resources>
                                <Style TargetType="TabPanel">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="CPU"        Style="{StaticResource ModernTab}"/>
                            <TabItem Header="GPU"        Style="{StaticResource ModernTab}"/>
                            <TabItem Header="RAM"        Style="{StaticResource ModernTab}"/>
                            <TabItem Header="NETWORK"    Style="{StaticResource ModernTab}"/>
                            <TabItem Header="DEBLOAT"    Style="{StaticResource ModernTab}"/>
                            <TabItem Header="POWER"      Style="{StaticResource ModernTab}"/>
                            <TabItem Header="LATENCY"    Style="{StaticResource ModernTab}"/>
                            <TabItem Header="GAME"       Style="{StaticResource ModernTab}"/>
                            <TabItem Header="BACKGROUND" Style="{StaticResource ModernTab}"/>
                            <TabItem Header="STORAGE"    Style="{StaticResource ModernTab}"/>
                            <TabItem Header="AUDIO"      Style="{StaticResource ModernTab}"/>
                            <TabItem Header="NUCLEAR"    Style="{StaticResource ModernTab}"/>
                            <TabItem Header="RESTORE"    Style="{StaticResource ModernTab}"/>
                        </TabControl>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweakList" 
                                          ItemTemplate="{StaticResource TweakCardTemplate}"
                                          Margin="24,12,24,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== APPS ========== -->
                    <Grid x:Name="PgApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="App Installer" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="SELECT APPS · THEN APPLY SELECTED" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="24,0,24,8" Background="{StaticResource BgCard}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AppSearch" Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextSecondary}"
                                         FontFamily="{StaticResource FontMono}" FontSize="11"
                                         CaretBrush="{StaticResource AccentViolet}" Padding="12,8"/>
                                <Button x:Name="BtnAppSearchClear" Grid.Column="1"
                                        Content="✕" Style="{StaticResource IconButton}" Margin="4,0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource AppCardTemplate}" Margin="24,0,24,24">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== SERVICES ========== -->
                    <Grid x:Name="PgServices" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Services" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="MANAGE WINDOWS SERVICES" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="24,0,24,10">
                            <Button x:Name="BtnSvcGaming"    Content="GAMING PROFILE"  Style="{StaticResource ActionButton}"  Margin="0,0,6,0"/>
                            <Button x:Name="BtnSvcNormal"    Content="NORMAL PROFILE"  Style="{StaticResource SuccessButton}" Margin="0,0,6,0"/>
                            <Button x:Name="BtnSvcDisableAll" Content="DISABLE ALL"    Style="{StaticResource WarningButton}" Margin="0,0,6,0"/>
                            <Button x:Name="BtnSvcRefresh"   Content="↻ REFRESH"       Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SvcList" ItemTemplate="{StaticResource ServiceItemTemplate}" Margin="24,0,24,24"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== STARTUP ========== -->
                    <Grid x:Name="PgStartup" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Startup" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="DISABLE STARTUP ENTRIES" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="24,0,24,10">
                            <Button x:Name="BtnStartupRefresh" Content="↻ REFRESH" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StartupList" Margin="24,0,24,24">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeLG}"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderMid}" BorderThickness="1"
                                                        CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding Hive}" FontFamily="{StaticResource FontMono}"
                                                               FontSize="{StaticResource FontSizeXS}"
                                                               Foreground="{StaticResource TextDark}" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Cmd}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource TextDark}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="3" Content="DISABLE" Tag="{Binding Name}"
                                                        Style="{StaticResource WarningButton}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== PRIVACY ========== -->
                    <Grid x:Name="PgPrivacy" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Privacy" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="SELECT PRIVACY TWEAKS · THEN APPLY SELECTED" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PrivList" ItemTemplate="{StaticResource PrivacyItemTemplate}" Margin="24,0,24,24"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== SYSTEM INFO ========== -->
                    <Grid x:Name="PgDiag" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="System Info" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="HARDWARE OVERVIEW" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="24,0,24,10">
                            <Button x:Name="BtnDiagRefresh" Content="↻ REFRESH" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiagList" Margin="24,0,24,24">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AccentCard}" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource AccentVioletDark}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Lbl}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource AccentViolet}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Val}"
                                                               FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeLG}"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Sub}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                               Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== BENCHMARKS ========== -->
                    <ScrollViewer x:Name="PgBench" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Benchmarks" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="SYSTEM PERFORMANCE TESTS" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnBRunAll" Content="▶  RUN ALL"
                                        Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentViolet}">
                                    <StackPanel>
                                        <TextBlock Text="DISK WRITE" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BDiskVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentViolet}"/>
                                        <TextBlock Text="MB/s" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BDiskBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentViolet}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBDisk" Content="TEST WRITE" Style="{StaticResource ActionButton}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentCyan}">
                                    <StackPanel>
                                        <TextBlock Text="DISK READ" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BDiskRVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                        <TextBlock Text="MB/s" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BDiskRBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBDiskR" Content="TEST READ" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource AccentCyan}" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentBlue}">
                                    <StackPanel>
                                        <TextBlock Text="RAM BANDWIDTH" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BRamVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                        <TextBlock Text="MB/s" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BRamBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBRam" Content="TEST RAM" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource AccentBlue}" Foreground="{StaticResource AccentBlue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentAmber}">
                                    <StackPanel>
                                        <TextBlock Text="CPU PRIMES/S" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BCpuVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/>
                                        <TextBlock Text="primes/sec" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BCpuBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentAmber}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBCpu" Content="TEST CPU" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource AccentAmber}" Foreground="{StaticResource AccentAmber}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentGreen}">
                                    <StackPanel>
                                        <TextBlock Text="NETWORK PING" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BNetVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        <TextBlock Text="ms avg" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BNetBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBNet" Content="TEST PING" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource AccentGreen}" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentPink}">
                                    <StackPanel>
                                        <TextBlock Text="DNS LATENCY" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="BDnsVal" Text="--" FontFamily="{StaticResource FontMono}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentPink}"/>
                                        <TextBlock Text="ms avg" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDim}"/>
                                        <ProgressBar x:Name="BDnsBar" Value="0" Maximum="100" Height="3" Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentPink}" BorderThickness="0" Margin="0,8,0,8"/>
                                        <Button x:Name="BtnBDns" Content="TEST DNS" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource AccentPink}" Foreground="{StaticResource AccentPink}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="HISTORY" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource DarkCard}" Padding="14,12">
