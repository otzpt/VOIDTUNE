                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProcList" Margin="24,0,24,24">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,10,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                                                   Foreground="#9333EA" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" (" FontFamily="Consolas" FontSize="9" Foreground="#3D3560"/>
                                                        <TextBlock Text="{Binding ItemCount}" FontFamily="Consolas" FontSize="9" Foreground="#3D3560"/>
                                                        <TextBlock Text=")" FontFamily="Consolas" FontSize="9" Foreground="#3D3560"/>
