                                        <Button Style="{StaticResource ColorSwatch}" Background="#EF4444" Tag="#EF4444"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#F97316" Tag="#F97316"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#F472B6" Tag="#F472B6"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#EAB308" Tag="#EAB308"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#64748B" Tag="#64748B"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#0EA5E9" Tag="#0EA5E9"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#8B5CF6" Tag="#8B5CF6"/>
                                        <Button Style="{StaticResource ColorSwatch}" Background="#10B981" Tag="#10B981"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="WALLPAPER" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource DarkCard}" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource BgInput}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4">
                                        <TextBox x:Name="PWallpaperPath" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontMono}"
                                                 FontSize="11" IsReadOnly="True" Padding="10,7"/>
                                    </Border>
                                    <Button Grid.Column="1" x:Name="PBtnWallpaperPick" Content="BROWSE"
                                            Style="{StaticResource ActionButton}" Margin="8,0,6,0"/>
                                    <Button Grid.Column="2" x:Name="PBtnWallpaperApply" Content="APPLY"
                                            Style="{StaticResource SuccessButton}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="DISPLAY TOOLS" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel>
                                <Button x:Name="PBtnColorMgmt"     Content="COLOR MANAGEMENT"  Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="PBtnCalibration"   Content="CALIBRATE DISPLAY" Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="PBtnClearTypeTune" Content="CLEARTYPE TUNER"   Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                                <Button x:Name="PBtnNightLight"    Content="NIGHT LIGHT"        Style="{StaticResource ActionButton}" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== DRIVERS ========== -->
                    <Grid x:Name="PgDrivers" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Driver Info" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="DriverCount" Text="--" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="24,0,24,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource BgCard}"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                                <TextBox x:Name="DrFilter" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextSecondary}"
                                         FontFamily="{StaticResource FontMono}" FontSize="11"
                                         CaretBrush="{StaticResource AccentViolet}" Padding="12,8"/>
                            </Border>
                            <Button Grid.Column="1" x:Name="BtnDriverRefresh" Content="↻ REFRESH"
                                    Style="{StaticResource ActionButton}" Margin="8,0,6,0"/>
                            <Button Grid.Column="2" x:Name="BtnDriverExport" Content="EXPORT CSV"
                                    Style="{StaticResource ActionButton}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DriverList" Margin="24,0,24,24">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeLG}"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Version}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Date}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Mfg}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}"
                                                           Foreground="{StaticResource TextDark}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="4" BorderBrush="{StaticResource BorderMid}" BorderThickness="1"
                                                        CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Cat}" FontFamily="{StaticResource FontMono}"
                                                               FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextDark}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== GPU HEALTH ========== -->
                    <ScrollViewer x:Name="PgGpuHealth" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,24">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPU Health" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="GPU STATUS AND MONITORING" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnGpuRefresh"    Content="↻ REFRESH"  Style="{StaticResource ActionButton}"  Margin="0,0,6,0"/>
                                    <Button x:Name="BtnOpenNvidiaSmi" Content="NVIDIA-SMI" Style="{StaticResource ActionButton}"  Margin="0,0,6,0"/>
                                    <Button x:Name="BtnOpenGpuZ"      Content="GPU-Z"      Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="ALL GPUS DETECTED" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="GH_AllGpus" Text="--"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <TextBlock Text="GPU USAGE" Style="{StaticResource SectionLabel}"/>
                            <ProgressBar x:Name="GH_UsageBar" Value="0" Maximum="100" Height="6"
                                         Background="{StaticResource BorderSubtle}" Foreground="{StaticResource AccentViolet}"
                                         BorderThickness="0" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentViolet}">
                                    <StackPanel><TextBlock Text="GPU" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_GPU" Text="--" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentVioletDark}">
                                    <StackPanel><TextBlock Text="VENDOR" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Vendor" Text="--" FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentViolet}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentVioletDark}">
                                    <StackPanel><TextBlock Text="DRIVER" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Driver" Text="--" FontFamily="{StaticResource FontMono}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentVioletDark}">
                                    <StackPanel><TextBlock Text="DRIVER DATE" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Driver_Date" Text="--" FontFamily="{StaticResource FontMono}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentCyan}">
                                    <StackPanel><TextBlock Text="VRAM TOTAL" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_VRAM_Total" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentCyan}">
                                    <StackPanel><TextBlock Text="VRAM FREE" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_VRAM_Free" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentViolet}">
                                    <StackPanel><TextBlock Text="GPU USAGE %" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_GPU_Usage" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentViolet}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentRed}">
                                    <StackPanel><TextBlock Text="TEMPERATURE" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Temperature" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentAmber}">
                                    <StackPanel><TextBlock Text="CORE CLOCK" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Core_Clock" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentAmber}">
                                    <StackPanel><TextBlock Text="MEM CLOCK" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Mem_Clock" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentGreen}">
                                    <StackPanel><TextBlock Text="FAN SPEED" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Fan_Speed" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Width="220" Margin="0,0,10,10" BorderBrush="{StaticResource AccentBlue}">
                                    <StackPanel><TextBlock Text="POWER DRAW" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock x:Name="GH_Power_Draw" Text="--" FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/></StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== LATENCY CHECK ========== -->
                    <Grid x:Name="PgLatency" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="24,20,24,0">
                            <TextBlock Text="Latency Check" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="SYSTEM LATENCY DIAGNOSTICS" Style="{StaticResource PageSubtitle}" Margin="0,3,0,12"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="24,0,24,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnRunLatency" Content="▶  RUN CHECK"
                                    Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" x:Name="BtnLatCopyLog" Content="COPY LOG"
                                    Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" x:Name="BtnLatSaveLog" Content="SAVE LOG"
                                    Style="{StaticResource ActionButton}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SCORE:" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeLG}"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LatScore" Text="--" FontFamily="{StaticResource FontMono}"
                                           FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentVioletLight}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Margin="24,0,24,24"
                                Background="{StaticResource BgCard}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="LatScroll" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="LatResults" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextMuted}"
                                         FontFamily="{StaticResource FontMono}" FontSize="11"
                                         IsReadOnly="True" TextWrapping="Wrap" Padding="14,12"
                                         Text="Click RUN LATENCY CHECK to begin..."/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════
                 LOG PANEL
            ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgLogBar}"
                    BorderBrush="{StaticResource GradHorizLine}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <Grid Margin="12,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="LOG" 
                                   FontFamily="{StaticResource FontMono}" 
                                   FontSize="{StaticResource FontSizeXS}"
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextDim}" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" x:Name="LogProg" 
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="2" 
                                     Background="{StaticResource BorderSubtle}" 
                                     Foreground="{StaticResource AccentViolet}"
                                     BorderThickness="0" 
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="LogStatus" 
                                   Text="IDLE" 
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeXS}" 
                                   Foreground="{StaticResource TextDim}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0"/>
                        <TextBlock Grid.Column="3" x:Name="LogCount" 
                                   Text="" 
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeXS}" 
                                   Foreground="{StaticResource TextDim}" 
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="4" x:Name="BtnLogClear" 
                                Content="CLEAR" 
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeXS}" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="{StaticResource TextDim}" 
                                Cursor="Hand" 
                                Padding="6,2"/>
                    </Grid>

                    <!-- Log Output -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogOut" 
                                   FontFamily="{StaticResource FontMono}" 
                                   FontSize="{StaticResource FontSizeMD}"
                                   Foreground="{StaticResource TextDim}" 
                                   TextWrapping="Wrap" 
                                   Padding="0,2,0,4"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── APPLY / REVERT PROGRESS OVERLAY ─────────────────────────────
                 Spans body + log (rows 1-2). Topbar stays accessible.
                 Shown/hidden via Show-ApplyOverlay / Hide-ApplyOverlay in PS1.
            ──────────────────────────────────────────────────────────────── -->
            <Grid x:Name="ApplyOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">

                <!-- Dark semi-transparent backdrop -->
                <Border>
                    <Border.Background>
                        <SolidColorBrush Color="#DC09070F"/>
                    </Border.Background>
                </Border>

                <!-- Progress card — galaxy style -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="440" CornerRadius="10" Padding="30,26">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.3" Center="0.5,0.5">
                            <GradientStop Color="#1E0E34" Offset="0"/>
                            <GradientStop Color="#0E0A1C" Offset="0.65"/>
                            <GradientStop Color="#09070F" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4C1D95" Offset="0"/>
                            <GradientStop Color="#9333EA" Offset="0.35"/>
                            <GradientStop Color="#F472B6" Offset="0.65"/>
                            <GradientStop Color="#4C1D95" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1.5</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#9333EA" BlurRadius="55" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Title -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="▶  " FontFamily="Consolas" FontSize="11"
                                       Foreground="#9333EA" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ApplyPopupTitle" Text="APPLYING TWEAKS"
                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       Foreground="#C084FC" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Current operation name -->
                        <TextBlock x:Name="ApplyPopupOp" Text="..."
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#D8D0F0" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,20" MaxWidth="380"/>

                        <!-- Progress bar -->
                        <Border CornerRadius="2.5" Background="#1A1530" Margin="0,0,0,14">
                            <ProgressBar x:Name="ApplyPopupBar" Value="0" Maximum="100" Height="6"
                                         Background="Transparent" Foreground="#9333EA"
                                         BorderThickness="0"/>
                        </Border>

                        <!-- Count + percent row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ApplyPopupCount" Text="0 / 0"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="#3D3560" Margin="0,0,14,0"/>
                            <TextBlock x:Name="ApplyPopupPct" Text="0%"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="#7C4DB8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>