<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Deliberately NOT a ProjectReference to VOIDTUNE.WinUI.csproj: that project's UseWinUI/
    WindowsAppSDK build pulls in MSIX/PRI resource-packaging targets (ExpandPriContent etc.)
    that require Visual Studio's UWP packaging workload, not just the .NET SDK — overkill for
    testing plain data/logic classes that have zero WinUI dependency. Compiling the specific
    files directly keeps this test project buildable with just `dotnet build`.
  -->
  <ItemGroup>
    <Compile Include="..\VOIDTUNE.WinUI\Models\Tweak.cs" Link="Source\Tweak.cs" />
    <Compile Include="..\VOIDTUNE.WinUI\Services\TweakCatalog.cs" Link="Source\TweakCatalog.cs" />
    <Compile Include="..\VOIDTUNE.WinUI\Services\HardwareInfo.cs" Link="Source\HardwareInfo.cs" />
    <Compile Include="..\VOIDTUNE.WinUI\Services\SystemMonitor.cs" Link="Source\SystemMonitor.cs" />
    <Compile Include="..\VOIDTUNE.WinUI\Services\VoidSchedulerService.cs" Link="Source\VoidSchedulerService.cs" />
  </ItemGroup>

</Project>
