<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:VOIDTUNE.WinUI.Services"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18">
            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="Latency" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="TIMER · DISK · MEMORY · NETWORK" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource BrandVioletSoft}" />
                </StackPanel>
                <Button x:Name="RunBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Run_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F5;" FontSize="14" />
                        <TextBlock Text="Run tests" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <muxc:ItemsRepeater x:Name="StatsRepeater">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="210" MinItemHeight="86"
                                            MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:Metric">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Label}" FontFamily="Consolas" FontSize="11" Opacity="0.55" />
                                <TextBlock Text="{x:Bind Value}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{x:Bind Hex, Converter={StaticResource HexToBrush}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>

            <TextBlock Text="Network" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource BrandVioletSoft}" Margin="0,4,0,0" />
            <ItemsControl x:Name="PingList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:PingResult">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,10" Margin="0,4">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Host}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind AvgText}" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="110" />
                                <TextBlock Grid.Column="2" Text="{x:Bind JitterText}" FontFamily="Consolas" Opacity="0.6" VerticalAlignment="Center" MinWidth="110" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="IssuesCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource WarnAmber}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ScoreText" FontWeight="SemiBold" FontSize="16" />
                    <ItemsControl x:Name="IssuesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
