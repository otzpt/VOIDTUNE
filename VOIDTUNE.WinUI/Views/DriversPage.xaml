<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models">

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Drivers" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="CountLine" Text="INSTALLED DEVICE DRIVERS" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource BrandVioletSoft}" />
            </StackPanel>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                      SelectionChanged="Category_Changed" />
            <Button Grid.Column="2" VerticalAlignment="Center" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />

        <ListView Grid.Row="2" x:Name="DriverList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DriverItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,10" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Mfg}" Opacity="0.55" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                                    BorderThickness="1" BorderBrush="{StaticResource BrandViolet}">
                                <TextBlock Text="{x:Bind Category}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource BrandVioletSoft}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.8" MinWidth="120" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Date}" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" MinWidth="90" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
