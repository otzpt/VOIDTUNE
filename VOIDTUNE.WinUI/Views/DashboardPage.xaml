<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="22" MaxWidth="1120" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="3">
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="SYSTEM HEALTH OVERVIEW" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource BrandVioletSoft}" />
            </StackPanel>

            <!-- Stat cards -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CPU" FontFamily="Consolas" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="CpuValue" Text="—%" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource BrandVioletSoft}" />
                        <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Height="4"
                                     Foreground="{StaticResource BrandViolet}" />
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RAM" FontFamily="Consolas" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="RamValue" Text="—" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource BrandVioletSoft}" />
                        <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Value="0" Height="4"
                                     Foreground="{StaticResource BrandViolet}" />
                    </StackPanel>
                </Border>

                <!-- Processes -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PROCESSES" FontFamily="Consolas" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="ProcValue" Text="—" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBlue}" />
                        <TextBlock Text="running" FontSize="12" Opacity="0.55" />
                    </StackPanel>
                </Border>

                <!-- Applied tweaks -->
                <Border Grid.Column="3" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="APPLIED" FontFamily="Consolas" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="AppliedValue" Text="0" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource SafeGreen}" />
                        <TextBlock Text="tweaks active" FontSize="12" Opacity="0.55" />
                    </StackPanel>
                </Border>

                <!-- Health -->
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="HEALTH" FontFamily="Consolas" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="HealthValue" Text="—" FontSize="32" FontWeight="Bold" />
                        <TextBlock x:Name="HealthLabel" Text="—" FontSize="12" Opacity="0.55" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick actions -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Quick actions" FontWeight="SemiBold" FontSize="16" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ApplySafeBtn" Click="ApplySafe_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="14" />
                                <TextBlock Text="Apply all SAFE tweaks" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RevertAllBtn" Click="RevertAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                <TextBlock Text="Revert all" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="HwLine" FontFamily="Consolas" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
