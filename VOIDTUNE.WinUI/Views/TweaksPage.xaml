<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero header -->
        <Border Grid.Row="0" CornerRadius="14" BorderThickness="1" BorderBrush="#3D8B5CF6"
                Background="{StaticResource HeroBackdrop}" Padding="24,18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Tweaks" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="REVERSIBLE SYSTEM OPTIMIZATIONS · QUALITY OVER QUANTITY"
                               Style="{StaticResource MonoCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Border Style="{StaticResource Chip}" Background="#2622C55E" BorderBrush="#5522C55E">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource SafeGreen}" />
                                <TextBlock Text="toggle to apply · auto-saved" FontFamily="Consolas" FontSize="10.5"
                                           Foreground="#86EFAC" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="HwChip" Text="—" FontFamily="Consolas" FontSize="10.5" Opacity="0.75" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource GlowCard}" Padding="18,12" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="HeroApplied" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource VoidGradient}" HorizontalAlignment="Center" />
                        <TextBlock Text="ACTIVE" Style="{StaticResource MonoLabel}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlowCard}" Padding="18,12" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="HeroTotal" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource BrandVioletSoft}" HorizontalAlignment="Center" />
                        <TextBlock Text="AVAILABLE" Style="{StaticResource MonoLabel}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource GlowCard}" Padding="18,12" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="HeroShown" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBlue}" HorizontalAlignment="Center" />
                        <TextBlock Text="SHOWN" Style="{StaticResource MonoLabel}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter + action bar -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryBox" Grid.Column="0" MinWidth="170"
                          SelectionChanged="Category_Changed" />
                <ComboBox x:Name="TierBox" Grid.Column="1" MinWidth="130" SelectionChanged="Tier_Changed">
                    <ComboBoxItem Content="All tiers" />
                    <ComboBoxItem Content="Safe" />
                    <ComboBoxItem Content="Extreme" />
                </ComboBox>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" QueryIcon="Find"
                                PlaceholderText="Search tweaks…" TextChanged="Search_Changed" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Apply SAFE" Click="ApplySafe_Click" Style="{ThemeResource AccentButtonStyle}" />
                <Button Click="ApplyExtreme_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource ExtremeViolet}" />
                        <TextBlock Text="Apply EXTREME" />
                    </StackPanel>
                </Button>
                <Button Content="Revert all" Click="RevertAll_Click" />
                <TextBlock VerticalAlignment="Center" Opacity="0.5" FontFamily="Consolas" FontSize="11"
                           Text="toggle any tweak to apply / revert — saved automatically" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <!-- Grouped tweak list -->
        <ListView Grid.Row="3" x:Name="TweakList" SelectionMode="None"
                  ItemContainerStyle="{x:Null}"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="models:TweakGroup">
                            <Grid Margin="0,14,0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                        Background="{x:Bind BgHex, Converter={StaticResource HexToBrush}}"
                                        BorderThickness="1"
                                        BorderBrush="{x:Bind Hex, Converter={StaticResource HexToBrush}}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                              Foreground="{x:Bind Hex, Converter={StaticResource HexToBrush}}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" FontFamily="Consolas"
                                           FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="3" Height="1" Margin="4,1,0,0" VerticalAlignment="Center"
                                           Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tweak">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                                    BorderThickness="1"
                                    BorderBrush="{x:Bind TierHex, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{x:Bind TierLabel}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                           Foreground="{x:Bind TierHex, Converter={StaticResource HexToBrush}}" />
                            </Border>

                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16"
                                      Foreground="{StaticResource SafeGreen}" VerticalAlignment="Center"
                                      Visibility="{x:Bind Applied, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                            <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" MinWidth="0"
                                          OnContent="" OffContent=""
                                          IsOn="{x:Bind Applied, Mode=OneWay}" Tag="{x:Bind}" Toggled="Tweak_Toggled" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="CountLine" FontFamily="Consolas" FontSize="11" Opacity="0.5"
                   Margin="0,8,0,12" />
    </Grid>
</Page>
