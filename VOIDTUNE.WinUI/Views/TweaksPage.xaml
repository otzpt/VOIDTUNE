<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Tweaks" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="REVERSIBLE SYSTEM OPTIMIZATIONS" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <!-- Filter + action bar -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryBox" Grid.Column="0" MinWidth="170"
                          SelectionChanged="Category_Changed" />
                <ComboBox x:Name="TierBox" Grid.Column="1" MinWidth="130" SelectionChanged="Tier_Changed">
                    <ComboBoxItem Content="All tiers" />
                    <ComboBoxItem Content="Safe" />
                    <ComboBoxItem Content="Extreme" />
                    <ComboBoxItem Content="Nuclear" />
                </ComboBox>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" QueryIcon="Find"
                                PlaceholderText="Search tweaks…" TextChanged="Search_Changed" />
                <CheckBox x:Name="NuclearCheck" Grid.Column="3" Content="Show NUCLEAR" VerticalAlignment="Center"
                          Foreground="{StaticResource NuclearRed}"
                          Checked="Nuclear_Checked" Unchecked="Nuclear_Unchecked" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Apply SAFE" Click="ApplySafe_Click" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Revert all" Click="RevertAll_Click" />
                <TextBlock VerticalAlignment="Center" Opacity="0.5" FontFamily="Consolas" FontSize="11"
                           Text="toggle any tweak to apply / revert — saved automatically" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <!-- Tweak list -->
        <ListView Grid.Row="3" x:Name="TweakList" SelectionMode="None"
                  ItemContainerStyle="{x:Null}"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tweak">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,5">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                                    BorderThickness="1"
                                    BorderBrush="{x:Bind TierHex, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{x:Bind TierLabel}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                           Foreground="{x:Bind TierHex, Converter={StaticResource HexToBrush}}" />
                            </Border>

                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16"
                                      Foreground="{StaticResource SafeGreen}" VerticalAlignment="Center"
                                      Visibility="{x:Bind Applied, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                            <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" MinWidth="0"
                                          OnContent="" OffContent=""
                                          IsOn="{x:Bind Applied, Mode=OneWay}" Tag="{x:Bind}" Toggled="Tweak_Toggled" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="CountLine" FontFamily="Consolas" FontSize="11" Opacity="0.5"
                   Margin="0,8,0,12" />
    </Grid>
</Page>
