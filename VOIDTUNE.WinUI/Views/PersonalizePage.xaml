<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.PersonalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:svc="using:VOIDTUNE.WinUI.Services"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Customization" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="MODS · THEME · TASKBAR · EXPLORER · ACCENT" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <!-- Accent color -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Accent color" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="CurrentSwatch" Width="22" Height="22" CornerRadius="5"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                    <TextBlock x:Name="CurrentAccentLabel" VerticalAlignment="Center" Opacity="0.7"
                               FontFamily="Consolas" FontSize="12" />
                </StackPanel>
                <GridView x:Name="AccentGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Accent_Click">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="svc:AccentColor">
                            <Border Width="38" Height="38" CornerRadius="7" Margin="3"
                                    Background="{x:Bind Hex, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="#22FFFFFF" BorderThickness="1" ToolTipService.ToolTip="{x:Bind Name}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" QueryIcon="Find"
                            PlaceholderText="Search mods…" TextChanged="Search_Changed" />
            <TextBlock x:Name="CountLine" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5"
                       FontFamily="Consolas" FontSize="11" />
        </Grid>

        <InfoBar Grid.Row="3" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <!-- Mod grid (Windhawk-style cards) -->
        <GridView Grid.Row="4" x:Name="ModGrid" ItemsSource="{x:Bind Mods}" SelectionMode="None"
                  Padding="0,4,0,20" ScrollViewer.HorizontalScrollMode="Disabled">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:PersonalizeToggle">
                    <Border Width="252" Height="152" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid Padding="16,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Left"
                                        Background="{x:Bind GroupHex, Converter={StaticResource HexToBrush}}">
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="#0B0B0F" />
                                </Border>
                                <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0"
                                              OnContent="" OffContent=""
                                              IsOn="{x:Bind Enabled, Mode=OneWay}" Tag="{x:Bind}" Toggled="Toggle_Changed" />
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3" Margin="0,10,0,0">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{x:Bind Group}" FontFamily="Consolas" FontSize="9"
                                       Foreground="{x:Bind GroupHex, Converter={StaticResource HexToBrush}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
