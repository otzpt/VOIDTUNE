<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolNegationConverter x:Key="Not" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Apps" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="ONE-CLICK INSTALL VIA WINGET" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CategoryBox" Grid.Column="0" MinWidth="170" SelectionChanged="Category_Changed" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Click="InstallSelected_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Install selected" />
                    </StackPanel>
                </Button>
                <Button Content="Clear" Click="Clear_Click" />
                <Button Content="Detect installed" Click="Detect_Click" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <ListView Grid.Row="3" x:Name="AppList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AppItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,11" Margin="0,5">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{x:Bind Selected, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Id}" Opacity="0.5" FontSize="11" FontFamily="Consolas" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Category}" VerticalAlignment="Center"
                                       Opacity="0.6" FontSize="11" FontFamily="Consolas" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{x:Bind StatusHex, Mode=OneWay, Converter={StaticResource HexToBrush}}" />
                            <Button Grid.Column="4" Content="Install" Click="InstallOne_Click" Tag="{x:Bind}"
                                    IsEnabled="{x:Bind Busy, Mode=OneWay, Converter={StaticResource Not}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="CountLine" FontFamily="Consolas" FontSize="11" Opacity="0.5"
                   Margin="0,8,0,12" />
    </Grid>
</Page>
