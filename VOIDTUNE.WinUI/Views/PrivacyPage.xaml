<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Privacy" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="TELEMETRY · ADS · SENSORS · TRACKING" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Click="ApplyAll_Click" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Harden privacy (all SAFE)" />
                </StackPanel>
            </Button>
            <Button Content="Revert all" Click="RevertAll_Click" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <ListView Grid.Row="3" x:Name="List" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tweak">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,5">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="7,2" BorderThickness="1"
                                    BorderBrush="{x:Bind TierHex, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{x:Bind TierLabel}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                           Foreground="{x:Bind TierHex, Converter={StaticResource HexToBrush}}" />
                            </Border>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource SafeGreen}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind Applied, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind Selected, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
