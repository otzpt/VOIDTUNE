<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.GpuHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:VOIDTUNE.WinUI.Services">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18">
            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="GPU Health" FontSize="30" FontWeight="Bold" />
                    <TextBlock x:Name="SubLine" Text="LIVE GPU TELEMETRY" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource BrandVioletSoft}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />

            <!-- Headline GPU card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource BrandViolet}" BorderThickness="1" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="GpuNameText" Text="Detecting…" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="GpuVendorText" Text="" Opacity="0.6" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Stat grid -->
            <muxc:ItemsRepeater x:Name="StatsRepeater">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="210" MinItemHeight="86"
                                            MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:GpuStat">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Label}" FontFamily="Consolas" FontSize="11" Opacity="0.55" />
                                <TextBlock Text="{x:Bind Value}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>

            <TextBlock Text="Temperature, clocks, fan and power require nvidia-smi (NVIDIA only). Other vendors show driver and VRAM info."
                       Opacity="0.5" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
