<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models">

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Backup &amp; Restore" FontSize="30" FontWeight="Bold" />
            <TextBlock x:Name="CountLine" Text="REGISTRY SNAPSHOTS" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Click="Create_Click" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Create backup now" />
                </StackPanel>
            </Button>
            <Button Content="Refresh" Click="Refresh_Click" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <ListView Grid.Row="3" x:Name="BackupList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BackupItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,11" Margin="0,5">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Created}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Note}" Opacity="0.55" FontSize="12" FontFamily="Consolas" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind KeyCountText}" VerticalAlignment="Center"
                                       Opacity="0.6" FontSize="11" FontFamily="Consolas" />
                            <Button Grid.Column="2" Content="Restore" Click="Restore_Click" Tag="{x:Bind}" />
                            <Button Grid.Column="3" Click="Delete_Click" Tag="{x:Bind}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
