<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.ScriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,28,32,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Script Runner" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="RUN POWERSHELL OR CMD AS ADMINISTRATOR" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ShellBox" Grid.Column="0" MinWidth="160" SelectedIndex="0">
                <ComboBoxItem Content="PowerShell" />
                <ComboBoxItem Content="Command Prompt" />
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Content="Clear" Click="Clear_Click" />
                <Button x:Name="RunBtn" Click="Run_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressRing x:Name="BusyRing" Grid.Column="3" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
        </Grid>

        <InfoBar Grid.Row="2" x:Name="Warn" IsOpen="True" IsClosable="True" Severity="Warning"
                 Message="Scripts run elevated with full system access. Only run code you trust and understand." />

        <TextBox Grid.Row="3" x:Name="ScriptBox" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="13" PlaceholderText="Write-Output &quot;Hello from VOIDTUNE&quot;&#x0a;Get-Process | Sort-Object CPU -Descending | Select-Object -First 5"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="4" Text="Output" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                   Foreground="{StaticResource BrandVioletSoft}" />

        <Border Grid.Row="5" Background="#0D0D12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer Padding="14,10">
                <TextBlock x:Name="OutputText" FontFamily="Consolas" FontSize="12.5" IsTextSelectionEnabled="True"
                           TextWrapping="Wrap" Foreground="#C8E6C9" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
