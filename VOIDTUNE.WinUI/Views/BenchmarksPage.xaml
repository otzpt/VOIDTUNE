<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.BenchmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:svc="using:VOIDTUNE.WinUI.Services"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18">
            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="Benchmarks" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="CPU · RAM · DISK" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource BrandVioletSoft}" />
                </StackPanel>
                <Button x:Name="RunBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Run_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                        <TextBlock Text="Run benchmark" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <muxc:ItemsRepeater x:Name="StatsRepeater">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="210" MinItemHeight="86"
                                            MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:Metric">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Label}" FontFamily="Consolas" FontSize="11" Opacity="0.55" />
                                <TextBlock Text="{x:Bind Value}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{x:Bind Hex, Converter={StaticResource HexToBrush}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>

            <TextBlock Text="Scores are relative to this machine and meant for before/after tweak comparison, not cross-system ranking."
                       Opacity="0.5" FontSize="12" TextWrapping="Wrap" />

            <!-- ── Tweak Validator: sustained stress A/B ─────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="22,18" Margin="0,10,0,0">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Tweak Validator" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock FontFamily="Consolas" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                                   Text="5 × 45s sustained all-core runs — long enough to heat-soak, repeated enough to beat luck. Run a baseline, apply your tweaks (reboot if asked), then run the comparison: you get a statistical verdict, including a thermal-throttle check." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BaselineBtn" Click="Baseline_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                <TextBlock Text="Run baseline (5×)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CompareBtn" Click="Compare_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                                <TextBlock Text="Run comparison (5×)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelStressBtn" Click="CancelStress_Click" Visibility="Collapsed" Content="Cancel" />
                        <Button x:Name="ClearBaselineBtn" Click="ClearBaseline_Click" IsEnabled="False" Content="Clear baseline" />
                    </StackPanel>

                    <ProgressBar x:Name="StressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="StressStatus" FontFamily="Consolas" FontSize="12" Opacity="0.7" Visibility="Collapsed" />

                    <TextBlock x:Name="BaselineInfo" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed" />
                    <InfoBar x:Name="VerdictBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
