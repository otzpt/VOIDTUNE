<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models">

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="3">
                <TextBlock Text="Startup" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="CountLine" Text="PROGRAMS THAT RUN AT LOGON" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource BrandVioletSoft}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <ListView Grid.Row="2" x:Name="StartupList" SelectionMode="None"
                  ItemsSource="{x:Bind _mgr.Items, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StartupItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,10" Margin="0,4">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Command}" Opacity="0.5" FontSize="11" FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Location, Mode=OneWay}" VerticalAlignment="Center"
                                       Opacity="0.6" FontSize="11" FontFamily="Consolas" />
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind Enabled, Mode=TwoWay}" Tag="{x:Bind}" Toggled="Toggle_Changed" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
