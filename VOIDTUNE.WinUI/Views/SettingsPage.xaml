<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="30" FontWeight="Bold" />

            <!-- About -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="VOIDTUNE Performance Suite" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="v0.8.14 · WinUI 3 edition" FontFamily="Consolas"
                               Foreground="{StaticResource BrandVioletSoft}" />
                    <TextBlock Text="A precision Windows optimization suite. Reversible tweaks, zero telemetry, open source under GPL-3."
                               Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <HyperlinkButton Content="github.com/otzpt/VOIDTUNE" NavigateUri="https://github.com/otzpt/VOIDTUNE"
                                     Padding="0" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{StaticResource BrandVioletSoft}" VerticalAlignment="Center" />
                        <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Check for updates on startup" />
                            <TextBlock x:Name="ChannelText" Text="Source: GitHub releases · otzpt/VOIDTUNE"
                                       Opacity="0.55" FontSize="12" FontFamily="Consolas" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoCheckToggle" HorizontalAlignment="Right" MinWidth="0"
                                      OnContent="On" OffContent="Off" Toggled="AutoCheck_Toggled" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckBtn" Click="Check_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="CheckRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>

                    <InfoBar x:Name="UpdateInfoBar" IsOpen="False" IsClosable="True" />

                    <!-- Shown when an update is available -->
                    <Border x:Name="UpdateCard" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{StaticResource BrandViolet}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="15" />
                            <ScrollViewer MaxHeight="160">
                                <TextBlock x:Name="UpdateNotes" Opacity="0.8" FontSize="12.5" TextWrapping="Wrap"
                                           FontFamily="Consolas" />
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="InstallBtn" Click="Install_Click" Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        <TextBlock x:Name="InstallBtnText" Text="Download &amp; install" />
                                    </StackPanel>
                                </Button>
                                <HyperlinkButton x:Name="ReleaseLink" Content="View on GitHub" />
                                <ProgressRing x:Name="InstallRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Developer -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEC7A;" FontSize="16" Foreground="{StaticResource BrandVioletSoft}" VerticalAlignment="Center" />
                        <TextBlock Text="Developer" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <StackPanel Spacing="2" MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Developer mode" />
                            <TextBlock Text="Unlocks the DevTools category — system probe, elevated console, and the block-based tweak builder. Work in progress; use of WIP features."
                                       Opacity="0.55" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DevModeToggle" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0"
                                      OnContent="On" OffContent="Off" Toggled="DevMode_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About this build -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="About this build" FontWeight="SemiBold" />
                    <TextBlock Text="Native C# / WinUI 3 (Windows App SDK). Mica backdrop, Fluent design, runs elevated. ~140 reversible tweaks, services, startup, drivers, GPU health, latency, benchmarks, app installer and more."
                               Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="InstallModeText" Opacity="0.55" FontSize="12" FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
