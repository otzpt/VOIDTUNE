<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VOIDTUNE.WinUI.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VOIDTUNE.WinUI.Models"
    xmlns:conv="using:VOIDTUNE.WinUI.Converters">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Services" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="WINDOWS SERVICE MANAGER" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource BrandVioletSoft}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Click="Gaming_Click" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                    <TextBlock Text="Gaming profile" />
                </StackPanel>
            </Button>
            <Button Content="Normal profile" Click="Normal_Click" />
            <Button Content="Refresh" Click="Refresh_Click" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True" />

        <ListView Grid.Row="3" x:Name="List" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ServiceItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,5">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" FontFamily="Consolas" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       Text="{x:Bind Status, Mode=OneWay}"
                                       Foreground="{x:Bind StatusHex, Mode=OneWay, Converter={StaticResource HexToBrush}}" />
                            <Button Grid.Column="2" Content="Disable" Tag="{x:Bind Name}" Click="Disable_Click" />
                            <Button Grid.Column="3" Content="Enable" Tag="{x:Bind Name}" Click="Enable_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
