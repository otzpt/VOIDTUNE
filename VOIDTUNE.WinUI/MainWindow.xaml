<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VOIDTUNE.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Ambient void: faint nebula glow over the Mica backdrop ===== -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.12,0.05" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#178B5CF6" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.95,1.0" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#12F472B6" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===== Custom title bar ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <!-- diamond mark -->
                <Grid Width="22" Height="22">
                    <Border Width="15" Height="15" CornerRadius="3"
                            BorderBrush="{StaticResource BrandViolet}" BorderThickness="1.6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45" CenterX="7.5" CenterY="7.5" />
                        </Border.RenderTransform>
                    </Border>
                    <Ellipse Width="5" Height="5" Fill="{StaticResource BrandPink}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="VOIDTUNE" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border Background="#251042" BorderBrush="{StaticResource BrandViolet}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="v0.8.8 · WinUI 3" FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource BrandVioletSoft}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Navigation shell ===== -->
        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             PaneDisplayMode="Left"
                             OpenPaneLength="232"
                             IsTitleBarAutoPaddingEnabled="False"
                             Loaded="Nav_Loaded"
                             SelectionChanged="Nav_SelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="dash">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="OPTIMIZE" />
                <muxc:NavigationViewItem Content="Tweaks" Tag="tweaks">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:Name="DevToolsHeader" Content="DEVTOOLS" Visibility="Collapsed" />
                <muxc:NavigationViewItem x:Name="DevToolsNav" Content="DevTools" Tag="devtools" Visibility="Collapsed">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEC7A;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="CONFIGURE" />
                <muxc:NavigationViewItem Content="Services" Tag="services">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Startup" Tag="startup">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B5;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Personalize" Tag="personalize">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="SYSTEM" />
                <muxc:NavigationViewItem Content="Drivers" Tag="drivers">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="GPU Health" Tag="gpu">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xF211;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Latency" Tag="latency">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Benchmarks" Tag="bench">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="TOOLS" />
                <muxc:NavigationViewItem Content="Apps" Tag="apps">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Backup &amp; Restore" Tag="backup">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Script Runner" Tag="script">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel Margin="4,0,4,6">
                    <HyperlinkButton NavigateUri="https://discord.gg/vAWqWD2e6R"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8F2;" FontSize="15" Foreground="{StaticResource BrandVioletSoft}" />
                            <TextBlock Text="Discord · support" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="UpdateBar" Grid.Row="0" Margin="12,12,12,0" IsOpen="False"
                         Severity="Informational" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Content="View update" Click="UpdateBar_View" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
