# VOIDTUNE .gitignore

# Runtime generated files - do not commit
voidtune_state.txt
voidtune_crash.log
logs/
backups/

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Compiled / packaged output (shipped via Releases, not the repo)
*.exe
*.msi
*.zip

# Installer build artefacts
installer/.wix/
installer/.build/
installer/*.wixpdb

# Temp
*.tmp
*.bak

# .NET / WinUI 3 build output
**/bin/
**/obj/
**/.vs/
*.user

# Installer / release artefacts (shipped via Releases)
VOIDTUNE.WinUI/installer/out/
