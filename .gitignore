# VOIDTUNE .gitignore

# Runtime generated files - do not commit
voidtune_state.txt
voidtune_crash.log
logs/
backups/

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Compiled / packaged output (shipped via Releases, not the repo)
*.exe
*.msi
*.zip

# Installer build artefacts
installer/.wix/
installer/.build/
installer/*.wixpdb

# Temp
*.tmp
*.bak

# Claude Code local config / auto-memory (personal, not shared with the team)
.claude/settings.local.json
.claude/memory/

# .NET / WinUI 3 build output
**/bin/
**/obj/
**/.vs/
*.user

# Installer / release artefacts (shipped via Releases)
VOIDTUNE.WinUI/installer/out/

# Code-signing certificate — never commit, personal to this machine
*.pfx
*.p12
codesign.pwd.txt
