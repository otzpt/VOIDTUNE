<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOIDTUNE" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True" ResizeMode="NoResize"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5">

  <Window.RenderTransform>
    <ScaleTransform x:Name="SplashScale" ScaleX="0.78" ScaleY="0.78"/>
  </Window.RenderTransform>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <!-- Expand from 78% to 100% with a soft overshoot -->
          <DoubleAnimation
              Storyboard.TargetName="SplashScale"
              Storyboard.TargetProperty="ScaleX"
              From="0.78" To="1.0" Duration="0:0:0.44">
            <DoubleAnimation.EasingFunction>
              <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation
              Storyboard.TargetName="SplashScale"
              Storyboard.TargetProperty="ScaleY"
              From="0.78" To="1.0" Duration="0:0:0.44">
            <DoubleAnimation.EasingFunction>
              <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <!-- Fade in slightly faster than the expand -->
          <DoubleAnimation
              Storyboard.TargetProperty="Opacity"
              From="0" To="1" Duration="0:0:0.22"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <!-- Galaxy frame -->
  <Border CornerRadius="10">
    <Border.Background>
      <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#130F22" Offset="0"/>
        <GradientStop Color="#09070F" Offset="0.65"/>
        <GradientStop Color="#07050C" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C1D95" Offset="0"/>
        <GradientStop Color="#9333EA" Offset="0.3"/>
        <GradientStop Color="#F472B6" Offset="0.7"/>
        <GradientStop Color="#4C1D95" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.BorderThickness>1.5</Border.BorderThickness>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Ambient glow — top left -->
      <Ellipse Grid.RowSpan="4" Width="200" Height="200"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-80,-60,0,0" Opacity="0.07" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#9333EA" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <!-- Ambient glow — bottom right -->
      <Ellipse Grid.RowSpan="4" Width="180" Height="180"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-60,-50" Opacity="0.08" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#F472B6" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Logo -->
      <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
          <!-- Diamond icon -->
          <Viewbox Width="42" Height="42" Margin="0,0,16,0" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Fill="#9333EA" Opacity="0.1" Data="M24,2 L46,24 L24,46 L2,24 Z"/>
              <Path Stroke="#9333EA" StrokeThickness="2" Fill="Transparent"
                    Data="M24,4 L44,24 L24,44 L4,24 Z"/>
              <Path Stroke="#C084FC" StrokeThickness="1.2" Fill="Transparent" Opacity="0.55"
                    Data="M24,11 L37,24 L24,37 L11,24 Z"/>
              <Path Stroke="#4C1D95" StrokeThickness="0.8" Opacity="0.4"
                    Data="M24,4 L24,44 M4,24 L44,24"/>
              <Ellipse Canvas.Left="20.5" Canvas.Top="20.5" Width="7" Height="7"
                       Fill="#F472B6" Opacity="0.9"/>
            </Canvas>
          </Viewbox>
          <!-- Text -->
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="VOID" FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                         Foreground="#F0EEFF" VerticalAlignment="Center">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#9333EA" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock Text="TUNE" FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                         VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#9333EA" Offset="0"/>
                    <GradientStop Color="#F472B6" Offset="1"/>
                  </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                  <DropShadowEffect Color="#F472B6" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
              </TextBlock>
            </StackPanel>
            <TextBlock Text="PERFORMANCE  SUITE" FontFamily="Consolas" FontSize="9"
                       HorizontalAlignment="Center" Margin="2,7,0,0">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#9333EA" Offset="0"/>
                  <GradientStop Color="#F472B6" Offset="1"/>
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Status -->
      <TextBlock x:Name="SplashStatus" Grid.Row="1"
                 Text="INITIALIZING..." FontFamily="Consolas" FontSize="9"
                 Foreground="#5A4E80" HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>

      <!-- Progress -->
      <ProgressBar x:Name="SplashProg" Grid.Row="2"
                   Value="0" Maximum="100" Height="2"
                   Background="#1A1530" Foreground="#9333EA"
                   BorderThickness="0" Margin="50,0,50,0"/>

      <!-- Version -->
      <TextBlock Grid.Row="3" Text="v0.8  ·  @otzpt"
                 FontFamily="Consolas" FontSize="8" Foreground="#2E2850"
                 HorizontalAlignment="Center" Margin="0,8,0,14"/>
    </Grid>
  </Border>
</Window>
